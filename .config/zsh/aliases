alias e="exit"
alias c="clear"

alias dotfiles='/usr/bin/git --git-dir=$HOME/.dotfiles/ --work-tree=$HOME'

alias lzd='lazydocker'

alias l='eza --icons=always --group-directories-first -l -a -h'
alias lg='eza --icons=always --group-directories-first -l -a -h --git'

alias claude-personal='CLAUDE_CONFIG_DIR=~/.claude claude --allow-dangerously-skip-permissions'
alias claude-otto='CLAUDE_CONFIG_DIR=~/.claude-otto claude --allow-dangerously-skip-permissions'

alias sail="[ -f sail ] && bash sail || bash vendor/bin/sail"
alias python=python3

alias legacyvim='NVIM_APPNAME="nvim-legacy" nvim'
alias v='nvim'
alias vim='nvim'

alias aws2="/usr/local/bin/aws"
